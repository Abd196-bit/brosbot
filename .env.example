DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional for fast test command deployment. Leave blank for global commands.
DISCORD_GUILD_ID=
BOT_ACTIVITY=BRO'S JAM • /poll
ANNOUNCEMENT_CHANNEL_ID=
VOTE_CHANNEL_ID=

JAM_NAME=BRO'S JAM 2
JAM_URL=https://itch.io/jam/
JAM_THEME=To be revealed
JAM_START=2027-01-01T12:00:00+05:30
JAM_END=2027-01-08T12:00:00+05:30
VOTING_END=2027-01-15T12:00:00+05:30

# Public Google Sheet used for the jam calendar. The bot reads Sheet1 when it starts.
JAM_SCHEDULE_SHEET_ID=1eUQWqHJRcVSBGduZP5l0s2BhcjzTksbIfwp8tgO02CY
JAM_SCHEDULE_TIMEZONE=+05:30

# Wispbyte persists files inside the server's file manager.
POLL_DATA_DIR=./data

# Deploy google-apps-script/Code.gs as a web app from the poll spreadsheet.
# Copy the published script.google.com/macros/s/.../exec URL, not /dev or a googleusercontent.com redirect.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=

# Separate webhook for /vote themes, targeting the new theme spreadsheet.
# Deploy google-apps-script/ThemeVotes.gs as its own Apps Script project.
THEME_SHEETS_WEBHOOK_URL=
THEME_SHEETS_WEBHOOK_SECRET=

# Firebase Firestore: create a service-account key, minify its JSON onto one line,
# and keep it secret. Every poll/theme submission, vote change, and closure is saved.
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_COLLECTION=october

# Email verification (Gmail App Password, never your normal Gmail password).
DASHBOARD_URL=https://your-vercel-dashboard.vercel.app
# Set on Vercel only. Protects organiser dashboard.
DASHBOARD_PASSWORD=
VERIFIED_ROLE_ID=
VERIFY_CHANNEL_ID=
# Set the same random secret on the bot and Vercel.
VERIFICATION_LINK_SECRET=
# Set SMTP variables on Vercel only.
EMAIL_FROM=brosjam.verify@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=brosjam.verify@gmail.com
SMTP_APP_PASSWORD=
VERIFICATION_SHEETS_WEBHOOK_URL=
VERIFICATION_SHEETS_WEBHOOK_SECRET=
# Optional legacy cloud poll API. Only needed if still using /api/polls directly.
BOT_API_SECRET=
